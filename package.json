{
  "name": "gold-loan-management-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Pawn Shop Manager",
  "description": "Gold Loan Management System",
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "*",
    "exceljs": "^4.4.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.487.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^17.0.6",
    "react-resizable-panels": "^2.1.7",
    "sql.js": "^1.14.1",
    "tailwind-merge": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.10",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "typescript": "^5.7.3",
    "vite": "6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wait-on": "^9.0.4"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "copy-wasm": "node -e \"require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'public/sql-wasm.wasm')\"",
    "prebuild": "npm run copy-wasm",
    "build": "vite build",
    "electron:dev": "npm run copy-wasm && concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run copy-wasm && vite build && electron-builder",
    "electron:package": "npm run copy-wasm && vite build && electron-packager . GoldLoanManager --platform=win32 --arch=x64 --out=dist-desktop --overwrite --icon=logo.ico --ignore=\"(dist-desktop|src|public|gold_loan_data\\.db|node_modules/\\.bin|node_modules/electron|node_modules/electron-builder|node_modules/electron-packager|\\.git|\\.vscode|build_error.*)\""
  },
  "build": {
    "appId": "com.goldloan.manager",
    "productName": "Gold Loan Manager",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "public/**/*",
      "!gold_loan_data.db"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gold Loan Manager"
    }
  }
}
